{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/linuxserver/calibre-web"],
      "allowedVersions": "<1"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackagePatterns": ["postgresql", "postgres-init"],
      "allowedVersions": "<17"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackagePatterns": ["node"],
      "allowedVersions": "<20"
    },
    {
      "description": ["Gotenberg 9 is a breaking rewrite (litho PDF engine, new routes/stages); hold on major 8"],
      "matchDatasources": ["docker"],
      "matchPackagePatterns": ["gotenberg"],
      "allowedVersions": "<9"
    }
  ]
}
