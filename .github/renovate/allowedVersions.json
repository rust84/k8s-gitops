{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/linuxserver/calibre-web"],
      "allowedVersions": "<1"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackagePatterns": ["postgresql"],
      "allowedVersions": "<17"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackagePatterns": ["node"],
      "allowedVersions": "<20"
    },
    {
      "description": ["qbittorrent 5.3.0 was reverted in #7516; stay on 5.2.4 until it is fixed"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/home-operations/qbittorrent-libtorrentv1"],
      "allowedVersions": "5.2.4"
    },
   ]
}
